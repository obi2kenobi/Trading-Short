//@version=6
// ──────────────────────────────────────────────────────────────────────────────
// @title        TEMA-ST-WT PANIC HUNTER v3.4 — FOOTPRINT ENHANCED
// @description  Short aggressivo ottimizzato per catturare il panico di mercato
//               Trailing stop dinamico, partial exits, panic detection avanzato
//               v3.2: integrazione volume footprint (delta, POC, imbalances)
//               v3.3: Rimosso TP3 — sistema a 2 TP per eliminare residuo stoppato
//               v3.4: TP ottimizzati (TP1 0.3%/40%, TP2 1.2%/60%) + Breakeven dopo TP1
//               v3.5: TP1 Rebound Close + rimossa Drawdown Protection (falsata da TradingView)
//               Fix: TF operativo ora automatico da grafico (rimosso input manuale)
// @version      3.5
// @author       Ottimizzato per velocità e profitto
// ──────────────────────────────────────────────────────────────────────────────

// — TIMEFRAME —
tf = timeframe.period
tf_filter = input.string("D", "Timeframe filtro bear market", options = ["D","W"])

// — DATI MULTITF —
[close_tf, high_tf, low_tf, hl2_tf, hlc3_tf, vol_tf, open_tf] = request.security(syminfo.tickerid, tf, [close, high, low, hl2, hlc3, volume, open])
close_htf = request.security(syminfo.tickerid, tf_filter, close)
// FIX 1: ATR calcolati sul TF operativo (coerenti con i dati OHLC usati per Supertrend e trailing stop)
atr14 = request.security(syminfo.tickerid, tf, ta.atr(14))
atr10 = request.security(syminfo.tickerid, tf, ta.atr(10))

// — STRATEGY SETTINGS —
strategy("TEMA-ST-WT PANIC HUNTER v3.5", overlay=true,
     initial_capital    = 100000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 100,
     pyramiding         = 0,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.01,
     // FIX 3: era true → con dati multi-TF genera repainting nel backtest (tick sintetici)
     calc_on_every_tick = false)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT PARAMETERS - RISK MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

grpRisk = "═══ RISK MANAGEMENT ═══"
stopPerc_normal = input.float(2.0, "Stop Loss Normale %", minval=0.5, maxval=5.0, step=0.1, group=grpRisk) / 100
stopPerc_panic = input.float(1.2, "Stop Loss Panic Mode %", minval=0.3, maxval=3.0, step=0.1, group=grpRisk) / 100
useTrailingStop = input.bool(true, "Usa Trailing Stop", group=grpRisk)
trailATRmult = input.float(1.5, "Trailing Stop ATR Multiplier", minval=0.5, maxval=4.0, step=0.1, group=grpRisk)
useStructuralStop = input.bool(true, "Stop Strutturale in Strong Bear", group=grpRisk, tooltip="In Strong Bear usa il massimo recente + buffer ATR invece dello stop % fisso")
structStopATRbuffer = input.float(0.5, "Stop Strutturale ATR Buffer", minval=0.3, maxval=2.0, step=0.1, group=grpRisk, tooltip="Buffer ATR sopra il massimo recente per lo stop strutturale")
structStopLookback = input.int(3, "Lookback Massimi Stop", minval=2, maxval=8, group=grpRisk, tooltip="Numero di barre per il calcolo del massimo recente (stop strutturale)")
trailStrongBearMult = input.float(1.8, "Trail Multiplier Strong Bear", minval=1.0, maxval=3.0, step=0.1, group=grpRisk, tooltip="Moltiplica il trailing ATR in Strong Bear per dare più spazio ai rimbalzi tecnici")
trailBearMult = input.float(1.3, "Trail Multiplier Bear", minval=1.0, maxval=2.0, step=0.1, group=grpRisk, tooltip="Moltiplica il trailing ATR in Bear Market")
useDelayedTrail = input.bool(true, "Trailing Attivo Solo Dopo TP1", group=grpRisk, tooltip="Se attivo, il trailing stop si muove solo dopo che TP1 è stato colpito. Prima di TP1 lo stop iniziale (strutturale o %) rimane fisso.")
useBreakevenAfterTP1 = input.bool(true, "Breakeven Stop Dopo TP1", group=grpRisk, tooltip="Dopo che TP1 viene colpito, lo stop loss si sposta al prezzo di entry (breakeven). Protegge il residuo da inversioni.")
breakEvenBuffer = input.float(0.05, "Breakeven Buffer %", minval=0.0, maxval=0.5, step=0.01, group=grpRisk, tooltip="Piccolo buffer sotto entry per coprire spread/slippage. 0.05% = ~10 punti su NAS")
useMCcap = input.bool(false, "Stop Cap su Entry Open", group=grpRisk, tooltip="ATTENZIONE: può interferire con i TP parziali scalati. Lasciare OFF in modalità segnali manuali. Testare attentamente prima di attivare.")
mcCapATRmult = input.float(2.5, "Stop Cap ATR Multiplier", minval=1.0, maxval=5.0, step=0.1, group=grpRisk, tooltip="Stop cap = open entry + ATR * questo valore. Su 2H con ATR ~200pt: 2.5x = ~500pt = ~500$ per contratto. Aumenta per più spazio, diminuisci per meno rischio.")

grpTP = "═══ TAKE PROFIT SCALATO ═══"
usePartialTP = input.bool(true, "Usa Take Profit Parziali", group=grpTP)
useDynamicTP = input.bool(true, "TP Dinamici (basati su ATR)", group=grpTP, tooltip="I TP si adattano alla volatilità corrente. I valori % diventano fallback")
tp1_perc_input = input.float(0.3, "TP1 %", minval=0.1, maxval=5.0, step=0.1, group=grpTP, tooltip="TP1 % — soglia bassa per catturare l'88% dei trade") / 100
tp1_size = input.float(40, "TP1 Size %", minval=10, maxval=60, step=5, group=grpTP, tooltip="TP1 chiude il 40%, il 60% corre verso TP2") / 100
tp2_perc_input = input.float(1.2, "TP2 %", minval=0.5, maxval=10.0, step=0.1, group=grpTP, tooltip="TP2 % — chiude tutta la posizione rimanente") / 100
tp2_size = input.float(60, "TP2 Size %", minval=10, maxval=60, step=5, group=grpTP, tooltip="TP2 chiude il 60% restante — tutta la posizione") / 100
tpATRmult1 = input.float(0.5, "TP1 ATR Multiplier", minval=0.1, maxval=4.0, step=0.1, group=grpTP, tooltip="TP1 ATR Multiplier — ~60-70 punti su NAS")
tpATRmult2 = input.float(1.8, "TP2 ATR Multiplier", minval=0.5, maxval=6.0, step=0.1, group=grpTP, tooltip="TP2 ATR Multiplier — ~240 punti su NAS")
useTP1ReboundClose = input.bool(true, "Chiudi su Rimbalzo a TP1", group=grpTP, tooltip="Dopo che TP1 viene colpito, se il prezzo rimbalza e ritocca il livello TP1 chiude tutta la posizione rimanente. Il TP1 diventa una resistenza di uscita.")
useRegimeTP = input.bool(true, "TP Adattivi al Regime", group=grpTP, tooltip="Scala i TP dinamici in base al regime di mercato e alla densità volumetrica")
regimeTPmult_sbVoid = input.float(1.8, "TP Multiplier Strong Bear + Vol Void", minval=1.0, maxval=3.0, step=0.1, group=grpTP, tooltip="Moltiplicatore TP in Strong Bear con vuoto volumetrico")
regimeTPmult_sb = input.float(1.4, "TP Multiplier Strong Bear", minval=1.0, maxval=2.5, step=0.1, group=grpTP, tooltip="Moltiplicatore TP in Strong Bear")
regimeTPmult_bear = input.float(1.2, "TP Multiplier Bear", minval=1.0, maxval=2.0, step=0.1, group=grpTP, tooltip="Moltiplicatore TP in Bear Market")
volVoidThreshold = input.float(0.7, "Soglia Vol Void", minval=0.4, maxval=0.9, step=0.05, group=grpTP, tooltip="Densità volumetrica sotto questa soglia = vuoto volumetrico")

grpPanic = "═══ PANIC DETECTION ═══"
volSpikeMultiplier = input.float(2.0, "Volume Spike Multiplier", minval=1.5, maxval=4.0, step=0.1, group=grpPanic)
panicBarATRmult = input.float(1.5, "Panic Bar Size (ATR mult)", minval=1.0, maxval=3.0, step=0.1, group=grpPanic)
rsiPanicLevel = input.int(35, "RSI Panic Threshold", minval=20, maxval=45, group=grpPanic)
usePanicMode = input.bool(true, "Abilita Panic Mode Aggressivo", group=grpPanic)
useSogliaRidottaBear = input.bool(true, "Soglia Ridotta in Strong Bear", group=grpPanic, tooltip="Abbassa soglia panicMode da 40 a 25 quando isStrongBear è attivo")
useBonusBreakout = input.bool(true, "Bonus Breakout Strutturale", group=grpPanic, tooltip="Aggiunge 15 punti al panicScore quando il prezzo è sotto la regressione lineare di lungo periodo in Strong Bear")

grpRegimeShift = "═══ REGIME SHIFT MONITOR ═══"
useRegimeShiftMonitor = input.bool(true, "Abilita Regime Shift Score", group=grpRegimeShift, tooltip="Calcola un punteggio 0-100 che misura quanto il regime SHORT sta perdendo forza. Solo indicativo, non modifica la logica operativa.")
showShiftDetail = input.bool(false, "Mostra dettaglio contributi", group=grpRegimeShift, tooltip="Se attivo, mostra nel dashboard ogni componente del punteggio Regime Shift")

grpFilter = "═══ FILTRI MERCATO ═══"
useBearFilter = input.bool(false, "Richiedi Bear Market (sotto TEMA200)", group=grpFilter, tooltip="Se disattivato, opera anche in bull market")
useVolumeFilter = input.bool(true, "Richiedi Volume Alto", group=grpFilter)
useLateralFilter = input.bool(true, "Evita Mercati Laterali", group=grpFilter)
useSessionFilter = input.bool(true, "Filtro Sessione (solo 4H)", group=grpFilter, tooltip="Su 4H, evita entry in orari a bassa liquidità. Ignorato su Daily")
sessionStart = input.int(8, "Sessione Inizio (UTC)", minval=0, maxval=23, group=grpFilter, tooltip="Ora UTC di inizio sessione attiva")
sessionEnd = input.int(21, "Sessione Fine (UTC)", minval=0, maxval=23, group=grpFilter, tooltip="Ora UTC di fine sessione attiva")

grpBearMode = "═══ SHORT BEAR (più selettivo) ═══"
useBearMode = input.bool(false, "Abilita SHORT BEAR mode", group=grpBearMode)
bearMinFear = input.float(3.0, "Fear Index minimo per BEAR %", minval=0, maxval=50, step=1, group=grpBearMode, tooltip="BEAR richiede almeno questo livello di paura. Fear Index ora scala 0-100")
bearMinFearReduced = input.float(7.0, "Fear Ridotto in Strong Bear %", minval=0, maxval=50, step=0.5, group=grpBearMode, tooltip="Fear Index minimo quando isStrongBear è attivo. Valore ridotto per bear strutturale")
bearMinRedBars = input.int(1, "Candele rosse consecutive minime", minval=1, maxval=5, group=grpBearMode)
cooldownBars = input.int(8, "Cooldown tra trade (barre)", minval=0, maxval=20, group=grpBearMode, tooltip="Barre minime tra un'uscita e una nuova entry")
strongBearExitBonus = input.float(2.5, "Exit Threshold Bonus Strong Bear", minval=0.0, maxval=4.0, step=0.5, group=grpBearMode, tooltip="Aggiunto alla soglia exit in Strong Bear per evitare uscite premature su rimbalzi tecnici")
rsiExitLevelBear = input.int(65, "RSI Exit Level Strong Bear", minval=55, maxval=75, group=grpBearMode, tooltip="RSI minimo per segnale exit in Strong Bear. Più alto = lascia correre più a lungo")
emergencyExitRsiBear = input.int(72, "Emergency Exit RSI Strong Bear", minval=65, maxval=80, group=grpBearMode, tooltip="RSI per emergency exit in Strong Bear. Più alto = protezione solo su rimbalzi veramente forti")

grpFP = "═══ FOOTPRINT ORDER FLOW ═══"
useFP = input.bool(true, "Enable Footprint Data", group=grpFP, tooltip="Richiede piano Premium/Ultimate. Se disabilitato, il sistema funziona esattamente come v3.1")
fpTicksPerRow = input.int(30, "Ticks per row", minval=1, maxval=200, group=grpFP, tooltip="NQ: 20-50 | RTY: 20-40. Granularità righe di prezzo")
fpVAPercent = input.int(70, "Value Area %", minval=50, maxval=90, group=grpFP)
fpImbalancePercent = input.int(300, "Imbalance threshold %", minval=100, maxval=500, group=grpFP, tooltip="300 = 3:1 ratio buy/sell. 400 = più selettivo")
fpDeltaDivBars = input.int(3, "Delta divergence lookback", minval=2, maxval=10, group=grpFP)
fpPanicBoostEnabled = input.bool(false, "Enable Panic Score Boost", group=grpFP, tooltip="FASE 2: Aggiunge punti al Panic Score quando il delta conferma selling aggressivo. Attivare solo dopo periodo di osservazione")
fpPanicBoostPoints = input.int(10, "Panic Score Boost Points", minval=5, maxval=20, group=grpFP, tooltip="Punti aggiunti al Panic Score quando delta è estremo negativo + sell imbalances")
fpExitEnabled = input.bool(false, "Enable Footprint Exit Warning", group=grpFP, tooltip="FASE 3: Delta divergence contribuisce all'exit score quando il trade è in profitto. Attivare solo dopo validazione")
fpExitWeight = input.float(2.0, "Exit Weight Delta Divergence", minval=1.0, maxval=4.0, step=0.5, group=grpFP, tooltip="Peso del segnale di exit footprint nel sistema di exit ponderato")

grpIndicators = "═══ INDICATORI ═══"
temaLen_in = input.int(28, "TEMA IN Period", minval=10, maxval=50, group=grpIndicators)
temaLen_out = input.int(24, "TEMA OUT Period", minval=10, maxval=50, group=grpIndicators)
stFactor_in = input.float(2.4, "Supertrend IN Factor", minval=1.5, maxval=4.0, step=0.1, group=grpIndicators)
stFactor_out = input.float(2.2, "Supertrend OUT Factor", minval=1.5, maxval=4.0, step=0.1, group=grpIndicators)
maxDistATR = input.float(2.5, "Max Distance ATR", minval=0.5, maxval=4.0, step=0.1, group=grpIndicators)

grpVisual = "═══ VISUALIZZAZIONE ═══"
showLabels = input.bool(true, "Mostra labels trade", group=grpVisual)
compactLabels = input.bool(true, "Labels compatte", group=grpVisual, tooltip="Mostra solo info essenziali nelle label")
labelSize = input.string("small", "Dimensione labels", options=["tiny", "small", "normal"], group=grpVisual)
showDashboard = input.bool(true, "Mostra dashboard", group=grpVisual)
showLevels = input.bool(true, "Mostra livelli SL/TP", group=grpVisual)
showBearFilter = input.bool(true, "Mostra TEMA 200 HTF", group=grpVisual)
showPanicZones = input.bool(false, "Evidenzia zone panic", group=grpVisual)
labelOffsetATR = input.float(3.0, "Distanza Labels (ATR multiplier)", minval=1.0, maxval=8.0, step=0.5, group=grpVisual, tooltip="Distanza delle label dalle candele in multipli di ATR")

// ═══════════════════════════════════════════════════════════════════════════════
// FILTRO BEAR MARKET
// ═══════════════════════════════════════════════════════════════════════════════

tema200_htf = request.security(syminfo.tickerid, tf_filter, 3*ta.ema(close, 200) - 3*ta.ema(ta.ema(close, 200), 200) + ta.ema(ta.ema(ta.ema(close, 200), 200), 200))
ema50_htf = request.security(syminfo.tickerid, tf_filter, ta.ema(close, 50))

// Bear market confermato: prezzo sotto TEMA200 E EMA50 sotto TEMA200
isBearMarket = close_htf < tema200_htf
isStrongBear = isBearMarket and ema50_htf < tema200_htf

// ═══════════════════════════════════════════════════════════════════════════════
// PARAMETRI ADATTIVI PER TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════

// Timeframe detection
is15m = timeframe.period == "15"
is30m = timeframe.period == "30"
is45m = timeframe.period == "45"
isSubHourly = is15m or is30m or is45m
is4H = timeframe.period == "240"
isDaily = timeframe.period == "D" or timeframe.period == "1D"
isHighTF = isDaily

// Moltiplicatore adattivo per TF
tfStopMult     = isDaily ? 1.4 : (is4H ? 1.0 : (isSubHourly ? 0.9 : 1.2))
tfTrailMult    = isDaily ? 1.3 : (is4H ? 1.0 : (isSubHourly ? 0.9 : 1.1))
tfPanicMult    = isDaily ? 1.5 : (is4H ? 1.0 : (isSubHourly ? 0.8 : 1.2))
tfCooldownMult = isDaily ? 0.5 : (is4H ? 1.0 : (isSubHourly ? 1.5 : 0.75))

// Parametri adattati
adaptedStopNormal = stopPerc_normal * tfStopMult
adaptedStopPanic  = stopPerc_panic * tfStopMult
adaptedTrailATR   = trailATRmult * tfTrailMult
adaptedCooldown   = math.round(cooldownBars * tfCooldownMult)
adaptedPanicBarATR = panicBarATRmult * tfPanicMult

// ═══════════════════════════════════════════════════════════════════════════════
// PARAMETRI INTERNI
// ═══════════════════════════════════════════════════════════════════════════════

stPeriod  = 10
wtN1      = 10
// FIX 2: WT IN e OUT usavano lo stesso N2 → serie identiche. Ora differenziati:
//   IN  (entry): N2 più lungo = segnale più lento, meno falsi positivi in entrata
//   OUT (exit):  N2 più corto = segnale più rapido, uscita tempestiva
wtN2_in   = 21
wtN2_out  = 14
rsiLen    = 14

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME FOOTPRINT DATA (richiede Premium/Ultimate)
// ═══════════════════════════════════════════════════════════════════════════════

// UNA SOLA chiamata request.footprint() — estrarre TUTTO qui
footprint fp = useFP ? request.footprint(fpTicksPerRow, fpVAPercent, fpImbalancePercent) : na

// --- Metriche aggregate della barra ---
float fpDelta     = not na(fp) ? fp.delta() : na
float fpBuyVol    = not na(fp) ? fp.buy_volume() : na
float fpSellVol   = not na(fp) ? fp.sell_volume() : na
float fpTotalVol  = not na(fp) ? fp.total_volume() : na

// --- POC (Point of Control) ---
float fpPocHigh   = not na(fp) and not na(fp.poc()) ? fp.poc().up_price() : na
float fpPocLow    = not na(fp) and not na(fp.poc()) ? fp.poc().down_price() : na
float fpPocMid    = not na(fpPocHigh) and not na(fpPocLow) ? (fpPocHigh + fpPocLow) / 2.0 : na

// --- VAH / VAL ---
float fpVAH       = not na(fp) and not na(fp.vah()) ? fp.vah().up_price() : na
float fpVAL       = not na(fp) and not na(fp.val()) ? fp.val().down_price() : na

// --- Delta normalizzato ---
float fpAbsDelta    = not na(fpDelta) ? math.abs(fpDelta) : na
float fpAvgAbsDelta = ta.sma(nz(fpAbsDelta), 20)
float fpDeltaRatio  = fpAvgAbsDelta > 0 and not na(fpDelta) ? fpDelta / fpAvgAbsDelta : 0.0

// --- Buy/Sell Ratio ---
float fpBuySellRatio = not na(fpSellVol) and fpSellVol > 0 ? nz(fpBuyVol) / fpSellVol : na

// ═══════════════════════════════════════════════════════════════════════════════
// FOOTPRINT SIGNALS — ENTRY CONFIRMATION (SHORT)
// ═══════════════════════════════════════════════════════════════════════════════

// 1. EXTREME NEGATIVE DELTA: vendita aggressiva molto sopra la media
bool fpExtremeSell = not na(fpDelta) and fpDelta < 0 and fpAvgAbsDelta > 0 and math.abs(fpDelta) > fpAvgAbsDelta * 1.5

// 2. ABSORPTION: delta positivo ma candela bearish = compratori intrappolati
bool fpAbsorption = not na(fpDelta) and nz(fpDelta) > 0 and close_tf < open_tf

// 3. SELL PRESSURE ACCELERATION: delta sempre più negativo su barre consecutive
bool fpSellAccelerating = not na(fpDelta) and not na(fpDelta[1]) and fpDelta < 0 and fpDelta[1] < 0 and fpDelta < fpDelta[1]

// 4. POC MIGRATION DOWN: il punto di maggior volume scende
float fpPocSlope = not na(fpPocMid) and not na(fpPocMid[3]) ? (fpPocMid - fpPocMid[3]) / 3.0 : na
bool fpPocFalling = not na(fpPocSlope) and fpPocSlope < 0

// 5. DELTA DIVERGENCE SHORT: prezzo fa higher high ma delta è inferiore
bool fpDeltaDivShort = not na(fpDelta) and high_tf > ta.highest(high_tf[1], fpDeltaDivBars) and nz(fpDelta) < ta.highest(nz(fpDelta[1]), fpDeltaDivBars)

// Conteggio conferme SHORT footprint
int fpShortConfirmCount = (fpExtremeSell ? 1 : 0) + (fpAbsorption ? 1 : 0) + (fpSellAccelerating ? 1 : 0) + (fpPocFalling ? 1 : 0) + (fpDeltaDivShort ? 1 : 0)

// ═══════════════════════════════════════════════════════════════════════════════
// FOOTPRINT SIGNALS — EXIT WARNING (rimbalzo reale vs tecnico)
// ═══════════════════════════════════════════════════════════════════════════════

// 1. DELTA DIVERGENCE EXIT: prezzo continua a scendere ma delta sale
bool fpDeltaDivExit = not na(fpDelta) and low_tf < ta.lowest(low_tf[1], fpDeltaDivBars) and nz(fpDelta) > ta.lowest(nz(fpDelta[1]), fpDeltaDivBars)

// 2. BULLISH ABSORPTION: delta negativo ma candela verde
bool fpBullAbsorption = not na(fpDelta) and nz(fpDelta) < 0 and close_tf > open_tf

// 3. EXTREME BUY PRESSURE: delta molto positivo improvviso
bool fpExtremeBuy = not na(fpDelta) and fpDelta > 0 and fpAvgAbsDelta > 0 and fpDelta > fpAvgAbsDelta * 1.5

// 4. POC MIGRATION UP: il volume sta accettando prezzi più alti
bool fpPocRising = not na(fpPocSlope) and fpPocSlope > 0

// Conteggio segnali exit footprint
int fpExitWarningCount = (fpDeltaDivExit ? 1 : 0) + (fpBullAbsorption ? 1 : 0) + (fpExtremeBuy ? 1 : 0) + (fpPocRising ? 1 : 0)

// CVD approssimato (Cumulative Volume Delta)
var float fpCVD = 0.0
fpCVD := not na(fpDelta) ? fpCVD + fpDelta : fpCVD
float fpCVD_sma5 = ta.sma(fpCVD, 5)
bool fpCVDrising = fpCVD > fpCVD_sma5
bool fpCVDfalling = fpCVD < fpCVD_sma5

// ═══════════════════════════════════════════════════════════════════════════════
// PANIC DETECTION MODULE
// ═══════════════════════════════════════════════════════════════════════════════

// 1. VOLUME SPIKE DETECTION
volMA20 = ta.sma(vol_tf, 20)
volMA5 = ta.sma(vol_tf, 5)
isVolSpike = vol_tf > volMA20 * volSpikeMultiplier
isVolAccelerating = volMA5 > volMA20 * 1.3

// 2. PANIC BAR DETECTION (candele di panico)
candleBody = math.abs(close_tf - open_tf)
candleRange = high_tf - low_tf
isBearishCandle = close_tf < open_tf
isPanicBar = isBearishCandle and candleBody > atr14 * adaptedPanicBarATR and candleBody > candleRange * 0.7

// 3. RSI CRASH DETECTION
rsi = ta.rsi(close_tf, rsiLen)
rsi_prev = rsi[1]  // usa il valore RSI della barra precedente, non ricalcolare
isRsiPanic = rsi < rsiPanicLevel
isRsiCrashing = rsi < rsi_prev - 5 and rsi < 50  // RSI in caduta rapida

// 4. PRICE VELOCITY (accelerazione discesa)
priceChange1 = (close_tf - close_tf[1]) / close_tf[1] * 100
priceChange3 = (close_tf - close_tf[3]) / close_tf[3] * 100
isPriceAccelerating = priceChange1 < -0.5 and priceChange3 < -1.5

// 5. GAP DOWN DETECTION
gapDown = open_tf < low_tf[1]
significantGap = gapDown and (low_tf[1] - open_tf) > atr14 * 0.5

// 6. CONSECUTIVE RED BARS
redBar = close_tf < open_tf
consecutiveRed = redBar and redBar[1] and redBar[2]

// 7. STRUCTURAL BREAKOUT: prezzo sotto regressione lineare di lungo periodo
linregValue = ta.linreg(close_tf, 100, 0)
isBelowLinreg = close_tf < linregValue
isStructuralBreakout = isBelowLinreg and isStrongBear

// PANIC SCORE (0-100)
panicScore = 0
panicScore := panicScore + (isVolSpike ? 20 : 0)
panicScore := panicScore + (isPanicBar ? 25 : 0)
panicScore := panicScore + (isRsiPanic ? 15 : 0)
panicScore := panicScore + (isRsiCrashing ? 10 : 0)
panicScore := panicScore + (isPriceAccelerating ? 15 : 0)
panicScore := panicScore + (significantGap ? 10 : 0)
panicScore := panicScore + (consecutiveRed ? 5 : 0)
// MODIFICA 3: Bonus strutturale quando sotto regressione lineare in Strong Bear
panicScore := panicScore + (useBonusBreakout and isStructuralBreakout ? 15 : 0)

// MODIFICA v3.2: Bonus Footprint al Panic Score (solo se abilitato)
// Extreme selling + sell acceleration confermano panico reale nell'order flow
fpPanicBonus = 0
if fpPanicBoostEnabled and useFP and not na(fpDelta)
    // Delta estremo negativo: conferma il panico dal lato order flow
    if fpExtremeSell
        fpPanicBonus := fpPanicBonus + fpPanicBoostPoints
    // Sell acceleration: il panico sta peggiorando barra dopo barra
    if fpSellAccelerating
        fpPanicBonus := fpPanicBonus + math.round(fpPanicBoostPoints * 0.5)

panicScore := panicScore + fpPanicBonus

// MODIFICA 1: Soglia adattiva - in Strong Bear si abbassa da 40 a 25
panicThreshold = (useSogliaRidottaBear and isStrongBear) ? 25 : 40
isPanicMode = panicScore >= panicThreshold and usePanicMode

// ═══════════════════════════════════════════════════════════════════════════════
// FEAR INDEX (indicatore interno di paura)
// ═══════════════════════════════════════════════════════════════════════════════

// Volatility component
atrNorm = atr14 / ta.sma(atr14, 50) * 100 - 100  // deviazione dalla media
volComponent = math.min(50, math.max(0, atrNorm))

// RSI component (inverted: lower RSI = more fear)
rsiComponent = math.min(50, math.max(0, (50 - rsi)))

// Volume component
volRatio = vol_tf / volMA20
volFearComponent = math.min(30, math.max(0, (volRatio - 1) * 30))

// FEAR INDEX (0-100) - scalato correttamente
// Max teorico grezzo: volComponent(50)*0.3 + rsiComponent(50)*0.4 + volFearComponent(30)*0.3 = 44
// Normalizzato a 0-100 per rendere le soglie intuitive
rawFear = volComponent * 0.3 + rsiComponent * 0.4 + volFearComponent * 0.3
fearIndex = math.min(100, rawFear * 100 / 44)
isHighFear = fearIndex > 35

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME DENSITY & REGIME MULTIPLIER (per TP adattivi)
// ═══════════════════════════════════════════════════════════════════════════════

// Proxy vuoto volumetrico: densità volumetrica relativa breve/lungo termine
volSMA50 = ta.sma(vol_tf, 50)
volSMA200 = ta.sma(vol_tf, 200)
volDensity = volSMA200 > 0 ? volSMA50 / volSMA200 : 1.0
isVolVoid = volDensity < volVoidThreshold

// Moltiplicatore regime per TP dinamici
regimeMult = useRegimeTP ? (isStrongBear and isVolVoid ? regimeTPmult_sbVoid : (isStrongBear ? regimeTPmult_sb : (isBearMarket ? regimeTPmult_bear : 1.0))) : 1.0

// ═══════════════════════════════════════════════════════════════════════════════
// CORE INDICATORS
// ═══════════════════════════════════════════════════════════════════════════════

// TEMA IN / OUT (più veloci)
tema_in  = 3*ta.ema(close_tf, temaLen_in) - 3*ta.ema(ta.ema(close_tf, temaLen_in), temaLen_in) + ta.ema(ta.ema(ta.ema(close_tf, temaLen_in), temaLen_in), temaLen_in)
tema_out = 3*ta.ema(close_tf, temaLen_out) - 3*ta.ema(ta.ema(close_tf, temaLen_out), temaLen_out) + ta.ema(ta.ema(ta.ema(close_tf, temaLen_out), temaLen_out), temaLen_out)

// TEMA Slope
tema_slope = tema_in - tema_in[1]
tema_slope_ma = ta.sma(tema_slope, 3)
isTemaFalling = tema_slope < 0 and tema_slope_ma < 0
isTemaAccelerating = tema_slope < tema_slope[1] and tema_slope < 0

// Supertrend IN
upC_in = hl2_tf - stFactor_in * atr10
dnC_in = hl2_tf + stFactor_in * atr10
var float _up_in = na
var float _dn_in = na
var int trend_in = 0
_up_in := close_tf[1] > nz(_up_in[1], upC_in) ? math.max(upC_in, nz(_up_in[1], upC_in)) : upC_in
_dn_in := close_tf[1] < nz(_dn_in[1], dnC_in) ? math.min(dnC_in, nz(_dn_in[1], dnC_in)) : dnC_in
trend_in := close_tf > _dn_in[1] ? 1 : close_tf < _up_in[1] ? -1 : nz(trend_in[1])

// Supertrend OUT (più sensibile per exit veloci)
upC_out = hl2_tf - stFactor_out * atr10
dnC_out = hl2_tf + stFactor_out * atr10
var float _up_out = na
var float _dn_out = na
var int trend_out = 0
_up_out := close_tf[1] > nz(_up_out[1], upC_out) ? math.max(upC_out, nz(_up_out[1], upC_out)) : upC_out
_dn_out := close_tf[1] < nz(_dn_out[1], dnC_out) ? math.min(dnC_out, nz(_dn_out[1], dnC_out)) : dnC_out
trend_out := close_tf > _dn_out[1] ? 1 : close_tf < _up_out[1] ? -1 : nz(trend_out[1])

// WT IN (Wave Trend)
ap_in  = hlc3_tf
esa_in = ta.ema(ap_in, wtN1)
d_in   = ta.ema(math.abs(ap_in - esa_in), wtN1)
ci_in  = (ap_in - esa_in) / (0.015 * d_in)
wt1_in = ta.ema(ci_in, wtN2_in)
wt2_in = ta.sma(wt1_in, 4)
wtDown = wt1_in < wt2_in
wtCrossDown = ta.crossunder(wt1_in, wt2_in)

// WT OUT
ap_out  = hlc3_tf
esa_out = ta.ema(ap_out, wtN1)
d_out   = ta.ema(math.abs(ap_out - esa_out), wtN1)
ci_out  = (ap_out - esa_out) / (0.015 * d_out)
wt1_out = ta.ema(ci_out, wtN2_out)
wt2_out = ta.sma(wt1_out, 4)
wtUp = ta.crossover(wt1_out, wt2_out)
wtBullish = wt1_out > wt2_out

// Distance from TEMA
distATR = (tema_in - close_tf) / atr10

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Filtro lateralità (più permissivo in panic)
tema_slope_ratio = math.abs(tema_slope) / atr10
activeSlopeThreshold = isPanicMode ? 0.005 : (isBearMarket ? 0.012 : 0.015)
isFlatSlope = tema_slope_ratio < activeSlopeThreshold

rangeHigh5 = ta.highest(high_tf, 5)
rangeLow5  = ta.lowest(low_tf, 5)
rangeCond  = (rangeHigh5 - rangeLow5) / close_tf < 0.008
isLateral  = isFlatSlope and rangeCond and not isPanicMode

// Filtro volume (più permissivo in panic)
activeVolMult = isPanicMode ? 0.6 : (isBearMarket ? 0.7 : 0.9)
highVolume = vol_tf > volMA20 * activeVolMult

// Filtro sessione: su 4H evita orari morti, su Daily sempre attivo
currentHour = hour(time, "UTC")
inActiveSession = sessionStart < sessionEnd ? (currentHour >= sessionStart and currentHour < sessionEnd) : (currentHour >= sessionStart or currentHour < sessionEnd)
sessionOK = (not useSessionFilter) or isDaily or inActiveSession

// Filtri condizionali
bearOK = useBearFilter ? isBearMarket : true
volOK = useVolumeFilter ? highVolume : true
latOK = useLateralFilter ? not isLateral : true

// ═══════════════════════════════════════════════════════════════════════════════
// POSITION VARIABLES (dichiarate prima per uso in cooldown)
// ═══════════════════════════════════════════════════════════════════════════════

var float entryPrice = na
var float entryOpen = na
var int entryBar = na
var float trailStop = na
var float lowestSinceEntry = na
var bool tp1_hit = false
var bool tp2_hit = false
var string entryMode = ""

inShort = strategy.position_size < 0

// ═══════════════════════════════════════════════════════════════════════════════
// COOLDOWN & BEAR MODE FILTERS
// ═══════════════════════════════════════════════════════════════════════════════

// Track ultima uscita per cooldown e re-entry intelligente
var int lastExitBar = 0
var bool lastTradeWasProfit = false
var float lastExitProfit = 0.0

// Aggiorna lastExitBar quando usciamo da posizione
if inShort[1] and not inShort
    lastExitBar := bar_index
    // FIX 6: entryPrice potrebbe essere na al primo trade o dopo reset → guard esplicita
    if not na(entryPrice) and entryPrice != 0
        lastExitProfit    := (entryPrice - close_tf) / entryPrice
        lastTradeWasProfit := lastExitProfit > 0

// Cooldown intelligente: ridotto dopo trade profittevole se il trend continua
barsSinceExit = bar_index - lastExitBar
// Se l'ultimo trade era in profitto E il trend continua a scendere, cooldown dimezzato
smartCooldown = lastTradeWasProfit and isTemaFalling and (trend_in == -1) ? math.round(adaptedCooldown * 0.5) : adaptedCooldown
cooldownOK = barsSinceExit >= smartCooldown

// Conta candele rosse consecutive (per BEAR mode)
redBarsCount = 0
redBarsCount := close_tf < open_tf ? redBarsCount[1] + 1 : 0
hasEnoughRedBars = redBarsCount >= bearMinRedBars

// MODIFICA 2: Fear Index minimo adattivo - ridotto in Strong Bear
activeBearMinFear = isStrongBear ? bearMinFearReduced : bearMinFear
fearOK_bear = fearIndex >= activeBearMinFear

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY SIGNALS
// ═══════════════════════════════════════════════════════════════════════════════

// SCORE DIREZIONALE: almeno 2 su 3 indicatori devono confermare la direzione short
dirScore = (trend_in == -1 ? 1 : 0) + (wtDown ? 1 : 0) + (isTemaFalling ? 1 : 0)
directionOK = dirScore >= 2  // 2/3 bastano, non servono tutti e 3

// CONDIZIONE SHORT STANDARD (BEAR) - richiede 2/3 segnali direzionali + filtri
// FIX 5: distATR < 0 significa prezzo SOPRA la TEMA → la condizione <=maxDistATR era sempre vera
//         Aggiunto distATR >= 0: si entra solo se il prezzo è sotto la TEMA (distanza positiva)
shortBearConditions = directionOK and (distATR >= 0 and distATR <= maxDistATR) and latOK and volOK and bearOK and sessionOK
shortBearFilters = hasEnoughRedBars and fearOK_bear and cooldownOK
shortStandard = useBearMode and shortBearConditions and shortBearFilters

// CONDIZIONE SHORT PANIC (più aggressiva - ignora alcuni filtri, ma rispetta cooldown)
shortPanic = isPanicMode and (trend_in == -1 or isPanicBar) and (wtDown or isRsiPanic) and isVolSpike and cooldownOK

// CONDIZIONE SHORT FINALE
shortOK = shortStandard or shortPanic

// Entry
// FIX 3: barstate.isconfirmed evita entry su tick intrabar non confermati (anti-repainting)
if not inShort and shortOK and barstate.isconfirmed
    strategy.entry("Short", strategy.short)

// ═══════════════════════════════════════════════════════════════════════════════
// POSITION MANAGEMENT & TRAILING STOP
// ═══════════════════════════════════════════════════════════════════════════════

// Stop strutturale: massimo recente + buffer ATR (per Strong Bear)
stopStrutturale = ta.highest(high_tf, structStopLookback) + atr14 * structStopATRbuffer
useStructStop = useStructuralStop and isStrongBear

// Reset on new position
if inShort and not inShort[1]
    entryPrice := strategy.position_avg_price
    entryOpen := open_tf
    entryBar := bar_index
    // Stop cap: limita lo stop sopra open entry + ATR buffer per evitare margin call su gap
    stopCap = useMCcap and not na(entryOpen) ? entryOpen + atr14 * mcCapATRmult : na
    // In Strong Bear usa stop strutturale, altrimenti stop % fisso — con cap se abilitato
    if useStructStop
        rawStop = stopStrutturale
        trailStop := not na(stopCap) ? math.min(rawStop, stopCap) : rawStop
    else
        rawStop = entryPrice * (1 + (isPanicMode ? adaptedStopPanic : adaptedStopNormal))
        trailStop := not na(stopCap) ? math.min(rawStop, stopCap) : rawStop
    lowestSinceEntry := close_tf
    tp1_hit := false
    tp2_hit := false
    entryMode := isPanicMode ? "PANIC" : "STANDARD"

// Update trailing stop
// Moltiplicatore regime per trailing ATR: più spazio in bear strutturale
trailRegimeMult = isStrongBear ? trailStrongBearMult : (isBearMarket ? trailBearMult : 1.0)
effectiveTrailATR = adaptedTrailATR * trailRegimeMult

// Trailing attivo solo dopo TP1 se useDelayedTrail è abilitato
trailActive = useDelayedTrail ? tp1_hit : true

// Stop cap ricalcolato ogni barra (entryOpen è fisso, atr14 aggiornato)
stopCap = useMCcap and not na(entryOpen) ? entryOpen + atr14 * mcCapATRmult : na

if inShort
    lowestSinceEntry := math.min(lowestSinceEntry, low_tf)

    if useTrailingStop and trailActive
        // Trailing stop basato su ATR dal minimo, con regime multiplier
        newTrailStop = lowestSinceEntry + atr14 * effectiveTrailATR

        // Il trailing stop può solo scendere (per short), con guard per na
        if na(trailStop) or newTrailStop < trailStop
            trailStop := newTrailStop
    else if not trailActive and useMCcap
        // Prima di TP1: applica cap se necessario (protezione gap)
        if not na(stopCap) and not na(trailStop) and trailStop > stopCap
            trailStop := stopCap

    // BREAKEVEN: dopo TP1, lo stop non sale sopra entry price (con buffer)
    if useBreakevenAfterTP1 and tp1_hit
        breakEvenPrice = entryPrice * (1 + breakEvenBuffer / 100)
        if na(trailStop) or trailStop > breakEvenPrice
            trailStop := breakEvenPrice

// Calcolo livelli
activeStopPerc = isPanicMode ? adaptedStopPanic : adaptedStopNormal
// Fallback senza trailing: in Strong Bear usa strutturale, altrimenti % fisso
stopPriceFallback = useStructStop ? stopStrutturale : entryPrice * (1 + activeStopPerc)
stopPrice = useTrailingStop ? trailStop : stopPriceFallback

// TP dinamici: basati su ATR e regimeMult al momento dell'entry, o % fisse come fallback
var float entryATR = na
var float entryRegimeMult = na
if inShort and not inShort[1]
    entryATR := atr14
    entryRegimeMult := regimeMult

// Calcola TP percentuali: usa ATR * entryRegimeMult (fisso all'entry) se abilitato, altrimenti % fissa
// na() guard su entryATR, entryPrice e entryRegimeMult per evitare errori al primo trade
tp1_perc = useDynamicTP and not na(entryATR) and entryATR > 0 and not na(entryPrice) and entryPrice > 0 and not na(entryRegimeMult) ? (entryATR * tpATRmult1 * entryRegimeMult) / entryPrice : tp1_perc_input
tp2_perc = useDynamicTP and not na(entryATR) and entryATR > 0 and not na(entryPrice) and entryPrice > 0 and not na(entryRegimeMult) ? (entryATR * tpATRmult2 * entryRegimeMult) / entryPrice : tp2_perc_input

tp1Price = entryPrice * (1 - tp1_perc)
tp2Price = entryPrice * (1 - tp2_perc)

// ═══════════════════════════════════════════════════════════════════════════════
// EXIT CONDITIONS (VELOCIZZATE)
// ═══════════════════════════════════════════════════════════════════════════════

// Exit signals con pesi (segnali più forti valgono di più)
exit_wt = wtUp or wtBullish
exit_st = trend_out == 1
exit_tema = close_tf > tema_out
// MODIFICA 2: RSI exit adattiva — soglia più alta in Strong Bear
rsiExitLevel = isStrongBear ? rsiExitLevelBear : 55
exit_rsi = rsi > rsiExitLevel and rsi > rsi_prev

// Pesi exit: Supertrend flip è il segnale più forte, WT il più debole
wt_exit_st   = 3.0   // Supertrend flip = segnale strutturale forte
wt_exit_tema = 2.5   // Prezzo sopra TEMA = inversione trend
wt_exit_rsi  = 2.0   // RSI in risalita = momentum cambia
wt_exit_wt   = 1.5   // WT bullish = più rumoroso, peso minore

// v3.2: Footprint exit signal — delta divergence indica che il ribasso perde forza
wt_exit_fp = fpExitEnabled and useFP ? fpExitWeight : 0.0
exit_fp = fpExitEnabled and useFP and not na(fpDelta) and fpDeltaDivExit and fpExitWarningCount >= 2

// Profit già realizzato
currentProfit = inShort ? (entryPrice - close_tf) / entryPrice : 0
hasProfit = currentProfit > tp1_perc

// EXIT PONDERATO: soglia adattiva al regime (v3.2: + footprint)
exitScore = (exit_wt ? wt_exit_wt : 0) + (exit_st ? wt_exit_st : 0) + (exit_tema ? wt_exit_tema : 0) + (exit_rsi ? wt_exit_rsi : 0) + (exit_fp ? wt_exit_fp : 0)
// MODIFICA 1: soglia base + bonus in Strong Bear per evitare cover premature
exitThresholdBase = hasProfit ? 4.0 : 6.0
exitThreshold = isStrongBear ? exitThresholdBase + strongBearExitBonus : exitThresholdBase
shouldExit = exitScore >= exitThreshold

// MODIFICA 3: Emergency exit adattiva — soglia RSI più alta in Strong Bear
emergencyExitLevel = isStrongBear ? emergencyExitRsiBear : 65
emergencyExit = rsi > emergencyExitLevel and inShort

exit_bar = inShort and (shouldExit or emergencyExit)

// ═══════════════════════════════════════════════════════════════════════════════
// REGIME SHIFT MONITOR (early warning softening regime SHORT)
// ═══════════════════════════════════════════════════════════════════════════════

// Componenti individuali del Regime Shift Score
int rssSTup = trend_in == 1 and trend_in[1] == 1 and trend_in[2] == 1 ? 20 : 0
int rssPanicDown = panicScore < nz(panicScore[1]) and nz(panicScore[1]) < nz(panicScore[2]) ? 15 : 0
float halfFearThresh = activeBearMinFear / 2
int rssFearLow = fearIndex < halfFearThresh and nz(fearIndex[1]) < halfFearThresh and nz(fearIndex[2]) < halfFearThresh ? 15 : 0
int rssAboveTema = close_tf > tema_in ? 15 : 0
int rssLowRed = redBarsCount <= 1 ? 10 : 0
int rssAtrCompress = not na(atr14[5]) and atr14 < atr14[5] * 0.85 ? 10 : 0
int rssExitDown = exitScore > 0 and exitScore < nz(exitScore[1]) and nz(exitScore[1]) < nz(exitScore[2]) ? 15 : 0

float regimeShiftScore = math.max(0, math.min(100, rssSTup + rssPanicDown + rssFearLow + rssAboveTema + rssLowRed + rssAtrCompress + rssExitDown))

// ═══════════════════════════════════════════════════════════════════════════════
// EXECUTE EXITS
// ═══════════════════════════════════════════════════════════════════════════════

if inShort
    // Take Profit Parziali
    if usePartialTP
        // TP1
        if not tp1_hit and close_tf <= tp1Price
            strategy.close("Short", comment="TP1", qty_percent=tp1_size * 100)
            tp1_hit := true

        // TP1 Rebound Close — tp1_hit[1] evita conflitto sulla stessa barra del TP1
        if useTP1ReboundClose and tp1_hit[1] and not tp2_hit and close_tf >= tp1Price
            strategy.cancel_all()
            strategy.close_all(comment="TP1 Rebound")
            tp2_hit := true

        // TP2 - chiude tutta la posizione rimanente
        if not tp2_hit and tp1_hit[1] and close_tf <= tp2Price
            strategy.cancel_all()
            strategy.close_all(comment="TP2")
            tp2_hit := true

        // SL attivo solo se la posizione non è stata chiusa dai TP
        if not tp2_hit
            strategy.exit("SL", from_entry="Short", stop=stopPrice)
    else
        // Single TP/SL
        strategy.exit("SL/TP", from_entry="Short", stop=stopPrice, limit=tp2Price)

    // Forza chiusura: se tp2_hit è true ma siamo ancora in posizione, chiudi ogni barra
    if tp2_hit
        strategy.cancel_all()
        strategy.close_all(comment="Force Close")

    // Signal-based exit - emergency esce sempre, cover solo se TP1 già colpito o TP disabilitati
    if exit_bar
        if emergencyExit
            strategy.cancel_all()
            strategy.close_all(comment="EMERGENCY")
        else if not usePartialTP or tp1_hit
            strategy.cancel_all()
            strategy.close_all(comment="Cover")

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════════════════

// TEMA 200 HTF
plot(showBearFilter ? tema200_htf : na, "TEMA 200 HTF", color=isBearMarket ? color.new(color.red, 40) : color.new(color.green, 40), linewidth=3)

// TEMA lines
plot(tema_in, "TEMA IN", color=color.new(color.purple, 0), linewidth=2)
plot(tema_out, "TEMA OUT", color=color.new(color.blue, 50), linewidth=1, style=plot.style_circles)

// Supertrend
plot(trend_in==-1 ? _dn_in : na, "ST Dn", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(trend_in==1 ? _up_in : na, "ST Up", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

// Background
bgcolor(showPanicZones and isPanicMode ? color.new(color.orange, 85) : na, title="Panic Zone")
bgcolor(isBearMarket ? color.new(color.red, 97) : color.new(color.green, 97), title="Bear/Bull")
bgcolor(inShort ? color.new(color.red, 92) : na, title="In Position")

// SL/TP levels
plot(showLevels and inShort ? stopPrice : na, "Stop Loss", color=color.new(color.red, 0), linewidth=2, style=plot.style_cross)
plot(showLevels and inShort ? tp1Price : na, "TP1", color=color.new(color.lime, 60), linewidth=1, style=plot.style_circles)
plot(showLevels and inShort ? tp2Price : na, "TP2", color=color.new(color.lime, 40), linewidth=1, style=plot.style_circles)
plot(showLevels and inShort ? entryPrice : na, "Entry", color=color.new(color.white, 0), linewidth=1, style=plot.style_circles)

// Footprint POC (solo se abilitato)
plot(useFP and not na(fpPocMid) ? fpPocMid : na, "FP POC", color=color.new(color.purple, 30), linewidth=2, style=plot.style_stepline)
plot(useFP and not na(fpVAH) ? fpVAH : na, "FP VAH", color=color.new(color.purple, 60), linewidth=1, style=plot.style_stepline)
plot(useFP and not na(fpVAL) ? fpVAL : na, "FP VAL", color=color.new(color.purple, 60), linewidth=1, style=plot.style_stepline)

// Entry signals
plotshape(shortStandard and not inShort and not shortPanic, "SHORT STD", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.normal)
plotshape(shortPanic and not inShort, "SHORT PANIC", shape.triangledown, location.abovebar, color.new(color.orange, 0), size=size.large)

// Exit signals
plotshape(exit_bar and not emergencyExit, "COVER", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.normal)
plotshape(emergencyExit, "EMERGENCY", shape.xcross, location.belowbar, color.new(color.yellow, 0), size=size.large)

// Panic indicators
plotshape(showPanicZones and isPanicBar and not inShort, "Panic Bar", shape.circle, location.belowbar, color.new(color.orange, 0), size=size.tiny)
plotshape(showPanicZones and isVolSpike, "Vol Spike", shape.diamond, location.abovebar, color.new(color.purple, 0), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// LABELS
// ═══════════════════════════════════════════════════════════════════════════════

// Calcolo offset per labels
labelOffset = atr14 * labelOffsetATR

// Dimensione label dinamica
lblSize = labelSize == "tiny" ? size.tiny : (labelSize == "small" ? size.small : size.normal)

if showLabels
    // Entry label (sopra le candele con offset)
    if shortOK and not inShort
        modeText = shortPanic ? "PANIC" : (isBearMarket ? "BEAR" : "STD")
        labelColor = shortPanic ? color.orange : color.red

        // Testo compatto o completo
        entryText = compactLabels ?
             "SHORT " + modeText + "\n" + str.tostring(close_tf, "#.##") :
             "SHORT " + modeText + "\nEntry: " + str.tostring(close_tf, "#.##") +
                  "\nSL: " + str.tostring(stopPrice, "#.##") +
                  "\nTP2: " + str.tostring(tp2Price, "#.##")

        label.new(bar_index, high_tf + labelOffset,
             text=entryText,
             style=label.style_label_down,
             color=labelColor,
             textcolor=color.white,
             size=lblSize)

    // Exit label (sotto le candele con offset)
    if exit_bar
        profitPct = ((entryPrice - close_tf) / entryPrice) * 100
        profitColor = profitPct > 0 ? color.green : color.red
        exitType = emergencyExit ? "EXIT!" : "Cover"

        // Testo compatto o completo
        exitText = compactLabels ?
             exitType + " " + str.tostring(profitPct, "#.#") + "%" :
             exitType + "\n" + str.tostring(close_tf, "#.##") +
                  "\nP&L: " + str.tostring(profitPct, "#.##") + "%"

        label.new(bar_index, low_tf - labelOffset,
             text=exitText,
             style=label.style_label_up,
             color=profitColor,
             textcolor=color.white,
             size=lblSize)

// TP hit labels - solo se non compatte
if showLabels and not compactLabels and inShort
    if tp1_hit and not tp1_hit[1]
        label.new(bar_index, low_tf - labelOffset * 0.5,
             text="TP1",
             style=label.style_label_up,
             color=color.new(color.green, 30),
             textcolor=color.white,
             size=size.tiny)
    if tp2_hit and not tp2_hit[1]
        label.new(bar_index, low_tf - labelOffset * 0.5,
             text="TP2",
             style=label.style_label_up,
             color=color.new(color.green, 20),
             textcolor=color.white,
             size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// LINEE ORIZZONTALI TP1 / TP2 / ENTRY / STOP
// ═══════════════════════════════════════════════════════════════════════════════

var line lineTP1   = na
var line lineTP2   = na
var line lineEntry = na
var line lineStop  = na
var label lblTP1   = na
var label lblTP2   = na
var label lblEntry = na
var label lblStop  = na

if inShort
    // — TP1 —
    if na(lineTP1)
        lineTP1 := line.new(bar_index, tp1Price, bar_index + 1, tp1Price, color=color.new(color.lime, 0), style=line.style_dashed, width=2, extend=extend.right)
    else
        line.set_xy1(lineTP1, bar_index, tp1Price)
        line.set_xy2(lineTP1, bar_index + 1, tp1Price)
    if na(lblTP1)
        lblTP1 := label.new(bar_index, tp1Price, text="TP1 " + str.tostring(tp1Price, "#.#"), style=label.style_label_left, color=color.new(#2E7D32, 0), textcolor=color.white, size=size.small)
    else
        label.set_xy(lblTP1, bar_index, tp1Price)
        label.set_text(lblTP1, "TP1 " + str.tostring(tp1Price, "#.#"))

    // — TP2 —
    if na(lineTP2)
        lineTP2 := line.new(bar_index, tp2Price, bar_index + 1, tp2Price, color=color.new(color.green, 0), style=line.style_solid, width=2, extend=extend.right)
    else
        line.set_xy1(lineTP2, bar_index, tp2Price)
        line.set_xy2(lineTP2, bar_index + 1, tp2Price)
    if na(lblTP2)
        lblTP2 := label.new(bar_index, tp2Price, text="TP2 " + str.tostring(tp2Price, "#.#"), style=label.style_label_left, color=color.new(#1B5E20, 0), textcolor=color.white, size=size.small)
    else
        label.set_xy(lblTP2, bar_index, tp2Price)
        label.set_text(lblTP2, "TP2 " + str.tostring(tp2Price, "#.#"))

    // — ENTRY —
    if na(lineEntry)
        lineEntry := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color=color.new(color.yellow, 30), style=line.style_dotted, width=1, extend=extend.right)
    else
        line.set_xy1(lineEntry, bar_index, entryPrice)
        line.set_xy2(lineEntry, bar_index + 1, entryPrice)
    if na(lblEntry)
        lblEntry := label.new(bar_index, entryPrice, text="ENTRY " + str.tostring(entryPrice, "#.#"), style=label.style_label_left, color=color.new(color.yellow, 30), textcolor=color.white, size=size.small)
    else
        label.set_xy(lblEntry, bar_index, entryPrice)
        label.set_text(lblEntry, "ENTRY " + str.tostring(entryPrice, "#.#"))

    // — STOP (trailing → aggiorna testo ogni barra) —
    if na(lineStop)
        lineStop := line.new(bar_index, stopPrice, bar_index + 1, stopPrice, color=color.new(color.red, 20), style=line.style_dashed, width=2, extend=extend.right)
    else
        line.set_xy1(lineStop, bar_index, stopPrice)
        line.set_xy2(lineStop, bar_index + 1, stopPrice)
    if na(lblStop)
        lblStop := label.new(bar_index, stopPrice, text="SL " + str.tostring(stopPrice, "#.#"), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    else
        label.set_xy(lblStop, bar_index, stopPrice)
        label.set_text(lblStop, "SL " + str.tostring(stopPrice, "#.#"))

else
    // Posizione chiusa → cancella tutto
    if not na(lineTP1)
        line.delete(lineTP1)
        lineTP1 := na
    if not na(lineTP2)
        line.delete(lineTP2)
        lineTP2 := na
    if not na(lineEntry)
        line.delete(lineEntry)
        lineEntry := na
    if not na(lineStop)
        line.delete(lineStop)
        lineStop := na
    if not na(lblTP1)
        label.delete(lblTP1)
        lblTP1 := na
    if not na(lblTP2)
        label.delete(lblTP2)
        lblTP2 := na
    if not na(lblEntry)
        label.delete(lblEntry)
        lblEntry := na
    if not na(lblStop)
        label.delete(lblStop)
        lblStop := na

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════

if showDashboard
    var table dashboard = table.new(position.bottom_right, 3, 27, bgcolor=color.new(color.black, 85), border_width=1)

    // Colori sezione
    hdrBg     = color.new(color.purple, 50)
    sectMkt   = color.new(#1a1a2e, 0)
    sectRisk  = color.new(#1a1a1a, 0)
    sectPos   = color.new(#0d1b2a, 0)
    rowBg     = color.new(color.black, 90)

    // ── HEADER ──  (row 0)
    tfLabel = is15m ? "15m" : (is30m ? "30m" : (is45m ? "45m" : (tf == "60" ? "1H" : (tf == "120" ? "2H" : (is4H ? "4H" : (isDaily ? "1D" : tf))))))
    statusDot = inShort ? "SHORT" : (shortOK ? "READY" : "IDLE")
    statusCol = inShort ? color.red : (shortOK ? color.lime : color.gray)
    table.cell(dashboard, 0, 0, "PANIC HUNTER", text_color=color.white, text_size=size.normal, bgcolor=hdrBg)
    table.cell(dashboard, 1, 0, "v3.5", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=hdrBg)
    table.cell(dashboard, 2, 0, tfLabel + " " + statusDot, text_color=statusCol, text_size=size.normal, bgcolor=hdrBg)

    // ── STATUS BAR: filtri rapidi con indicatori ──  (row 1)
    fBear = bearOK ? "B" : "b"
    fVol  = volOK ? "V" : "v"
    fLat  = latOK ? "L" : "l"
    fSess = sessionOK ? "S" : "s"
    fCool = cooldownOK ? "C" : "c"
    filterBar = fBear + " " + fVol + " " + fLat + " " + fSess + " " + fCool
    allFiltersOK = bearOK and volOK and latOK and sessionOK and cooldownOK
    table.cell(dashboard, 0, 1, "Filtri", text_color=color.gray, text_size=size.tiny, bgcolor=sectMkt)
    table.cell(dashboard, 1, 1, filterBar, text_color=allFiltersOK ? color.lime : color.orange, text_size=size.small, bgcolor=sectMkt)
    table.cell(dashboard, 2, 1, allFiltersOK ? "ALL OK" : "BLOCK", text_color=allFiltersOK ? color.lime : color.red, text_size=size.tiny, bgcolor=sectMkt)

    // ── SEZIONE MERCATO ──  (row 2)
    table.cell(dashboard, 0, 2, "MERCATO", text_color=color.white, text_size=size.tiny, bgcolor=sectMkt)
    table.cell(dashboard, 1, 2, "", bgcolor=sectMkt)
    table.cell(dashboard, 2, 2, "", bgcolor=sectMkt)

    // Market + Trend (row 3)
    marketStatus = isStrongBear ? "STRONG BEAR" : (isBearMarket ? "BEAR" : "BULL")
    marketColor = isStrongBear ? color.red : (isBearMarket ? color.orange : color.green)
    trendText = trend_in == -1 ? "DOWN" : "UP"
    trendColor = trend_in == -1 ? color.red : color.green
    table.cell(dashboard, 0, 3, "Regime", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, 3, marketStatus, text_color=marketColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, 3, "ST: " + trendText, text_color=trendColor, text_size=size.small, bgcolor=rowBg)

    // Fear + Panic (row 4)
    fearColor = fearIndex > 50 ? color.red : (fearIndex > 30 ? color.orange : color.green)
    panicColor = panicScore >= panicThreshold ? color.red : (panicScore >= panicThreshold * 0.6 ? color.orange : color.gray)
    modeText = isPanicMode ? "PANIC!" : ""
    threshText = str.tostring(panicScore) + "/" + str.tostring(panicThreshold) + " " + modeText
    table.cell(dashboard, 0, 4, "Fear/Panic", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, 4, str.tostring(fearIndex, "#.#") + "%", text_color=fearColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, 4, threshText, text_color=panicColor, text_size=size.small, bgcolor=rowBg)

    // RSI + Volume (row 5)
    rsiColor = rsi < 30 ? color.green : (rsi > 70 ? color.red : color.white)
    volText = isVolSpike ? "SPIKE!" : (highVolume ? "HIGH" : "LOW")
    volColor = isVolSpike ? color.orange : (highVolume ? color.green : color.gray)
    table.cell(dashboard, 0, 5, "RSI / Vol", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, 5, str.tostring(rsi, "#.#"), text_color=rsiColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, 5, volText, text_color=volColor, text_size=size.small, bgcolor=rowBg)

    // WT + TEMA + Direction Score (row 6)
    wtText = wtDown ? "BEAR" : "BULL"
    wtColor = wtDown ? color.red : color.green
    temaText = isTemaFalling ? "FALL" : "RISE"
    temaColor = isTemaFalling ? color.red : color.green
    dirScoreColor = dirScore >= 2 ? color.green : (dirScore >= 1 ? color.orange : color.red)
    table.cell(dashboard, 0, 6, "WT / TEMA", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, 6, wtText + " / " + temaText, text_color=dirScore >= 2 ? color.green : color.orange, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, 6, "Dir " + str.tostring(dirScore) + "/3", text_color=dirScoreColor, text_size=size.small, bgcolor=rowBg)

    // Vol Density (row 7) — NEW
    vdText = str.tostring(volDensity, "#.##")
    vdStatus = isVolVoid ? "VOL VOID" : "OK"
    vdColor = isVolVoid ? color.orange : color.green
    table.cell(dashboard, 0, 7, "Vol Density", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, 7, vdText, text_color=vdColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, 7, vdStatus, text_color=vdColor, text_size=size.small, bgcolor=rowBg)

    // ── FOOTPRINT ORDER FLOW ──  (row 8, 9, 10) — solo se abilitato
    if useFP
        table.cell(dashboard, 0, 8, "── ORDERFLOW ──", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.teal, 50))
        table.cell(dashboard, 1, 8, "", bgcolor=color.new(color.teal, 50))
        table.cell(dashboard, 2, 8, "", bgcolor=color.new(color.teal, 50))

        // Delta + Segnale (row 9)
        string deltaStr = not na(fpDelta) ? str.tostring(fpDelta, "#.#") : "N/A"
        color deltaCol = na(fpDelta) ? color.gray : fpDelta > 0 ? color.green : fpDelta < 0 ? color.red : color.white
        string deltaSignal = fpExtremeSell ? "SELL!" : fpAbsorption ? "ABSORB" : fpSellAccelerating ? "ACCEL↓" : fpDeltaDivShort ? "divSHORT" : "—"
        color sigCol = fpExtremeSell or fpSellAccelerating ? color.red : fpAbsorption ? color.orange : fpDeltaDivShort ? color.fuchsia : color.gray
        table.cell(dashboard, 0, 9, "Delta", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, 9, deltaStr, text_color=deltaCol, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, 9, deltaSignal, text_color=sigCol, text_size=size.small, bgcolor=rowBg)

        // POC + Conferme + Exit Warning (row 10)
        string pocStr = not na(fpPocMid) ? str.tostring(fpPocMid, "#.#") : "N/A"
        string pocDir = fpPocFalling ? "↓" : fpPocRising ? "↑" : "—"
        color pocCol = fpPocFalling ? color.red : fpPocRising ? color.green : color.white
        string confStr = "S:" + str.tostring(fpShortConfirmCount) + "/5"
        string warnStr = inShort ? " X:" + str.tostring(fpExitWarningCount) + "/4" : ""
        color confCol = fpShortConfirmCount >= 3 ? color.green : fpShortConfirmCount >= 1 ? color.white : color.gray
        table.cell(dashboard, 0, 10, "POC/Conf", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, 10, pocStr + " " + pocDir, text_color=pocCol, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, 10, confStr + warnStr, text_color=confCol, text_size=size.small, bgcolor=rowBg)

    // Offset per righe successive: +3 se footprint abilitato, +2/5 se regime shift
    int fpOffset = useFP ? 3 : 0
    int rsOffset = useRegimeShiftMonitor ? (showShiftDetail ? 5 : 2) : 0

    // ── REGIME SHIFT MONITOR ──  (row 8 + fpOffset, solo se abilitato)
    if useRegimeShiftMonitor
        // Header con colore in base alla soglia
        rsHdrBg = regimeShiftScore <= 30 ? color.new(color.red, 60) : (regimeShiftScore <= 55 ? color.new(color.orange, 60) : (regimeShiftScore <= 75 ? color.new(color.yellow, 60) : color.new(color.lime, 60)))
        table.cell(dashboard, 0, 8 + fpOffset, "REGIME SHIFT", text_color=color.white, text_size=size.tiny, bgcolor=rsHdrBg)
        table.cell(dashboard, 1, 8 + fpOffset, "", bgcolor=rsHdrBg)
        table.cell(dashboard, 2, 8 + fpOffset, "", bgcolor=rsHdrBg)

        // Score + interpretazione
        rsLabel = regimeShiftScore <= 30 ? "BEAR CONFIRMED" : (regimeShiftScore <= 55 ? "SOFTENING" : (regimeShiftScore <= 75 ? "TRANSITION?" : "REGIME SHIFT"))
        rsScoreColor = regimeShiftScore <= 30 ? color.red : (regimeShiftScore <= 55 ? color.orange : (regimeShiftScore <= 75 ? color.yellow : color.lime))
        table.cell(dashboard, 0, 9 + fpOffset, "Score", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, 9 + fpOffset, str.tostring(regimeShiftScore, "#") + "/100", text_color=rsScoreColor, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, 9 + fpOffset, rsLabel, text_color=rsScoreColor, text_size=size.small, bgcolor=rowBg)

        // Dettaglio contributi (3 righe, solo se abilitato)
        if showShiftDetail
            table.cell(dashboard, 0, 10 + fpOffset, "ST↑3+ " + (rssSTup > 0 ? "+20" : "—"), text_color=rssSTup > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)
            table.cell(dashboard, 1, 10 + fpOffset, "Pan↓3 " + (rssPanicDown > 0 ? "+15" : "—"), text_color=rssPanicDown > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)
            table.cell(dashboard, 2, 10 + fpOffset, "Fear↓ " + (rssFearLow > 0 ? "+15" : "—"), text_color=rssFearLow > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)

            table.cell(dashboard, 0, 11 + fpOffset, ">TEMA " + (rssAboveTema > 0 ? "+15" : "—"), text_color=rssAboveTema > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)
            table.cell(dashboard, 1, 11 + fpOffset, "Red≤1 " + (rssLowRed > 0 ? "+10" : "—"), text_color=rssLowRed > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)
            table.cell(dashboard, 2, 11 + fpOffset, "ATR↓ " + (rssAtrCompress > 0 ? "+10" : "—"), text_color=rssAtrCompress > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)

            table.cell(dashboard, 0, 12 + fpOffset, "Exit↓ " + (rssExitDown > 0 ? "+15" : "—"), text_color=rssExitDown > 0 ? color.green : color.gray, text_size=size.tiny, bgcolor=rowBg)
            table.cell(dashboard, 1, 12 + fpOffset, "", bgcolor=rowBg)
            table.cell(dashboard, 2, 12 + fpOffset, "", bgcolor=rowBg)

    // Base row per sezioni da RISK in poi
    int r = 8 + fpOffset + rsOffset

    // ── SEZIONE RISK ──  (row r)
    table.cell(dashboard, 0, r, "RISK", text_color=color.white, text_size=size.tiny, bgcolor=sectRisk)
    table.cell(dashboard, 1, r, "", bgcolor=sectRisk)
    table.cell(dashboard, 2, r, "", bgcolor=sectRisk)

    // Cooldown (row r+1)
    cooldownText = cooldownOK ? "OK" : str.tostring(math.max(0, smartCooldown - barsSinceExit)) + " bars"
    cooldownColor = cooldownOK ? color.green : color.orange
    table.cell(dashboard, 0, r + 1, "Cooldown", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, r + 1, cooldownText, text_color=cooldownColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, r + 1, "", bgcolor=rowBg)

    // Session (row r+2, solo su 4H)
    if is4H
        sessText = inActiveSession ? "ACTIVE" : "PAUSED"
        sessColor = inActiveSession ? color.green : color.orange
        table.cell(dashboard, 0, r + 2, "Session", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 2, str.tostring(sessionStart) + "-" + str.tostring(sessionEnd) + " UTC", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 2, sessText, text_color=sessColor, text_size=size.small, bgcolor=rowBg)

    // ── SEZIONE POSIZIONE / SEGNALI ──  (row r+3)
    posHdrBg = inShort ? color.new(color.red, 60) : color.new(color.teal, 70)
    posHdrText = inShort ? "POSIZIONE SHORT" : "IN ATTESA"
    table.cell(dashboard, 0, r + 3, posHdrText, text_color=color.white, text_size=size.tiny, bgcolor=posHdrBg)
    table.cell(dashboard, 1, r + 3, "", bgcolor=posHdrBg)
    table.cell(dashboard, 2, r + 3, "", bgcolor=posHdrBg)

    // TP Mult + Stop Type (row r+4)
    activeRegimeMult = inShort and not na(entryRegimeMult) ? entryRegimeMult : regimeMult
    regimeMultText = str.tostring(activeRegimeMult, "#.#") + "x"
    regimeMultColor = activeRegimeMult > 1.0 ? color.orange : color.white
    stopTypeText = useStructStop ? "STRUCT" : (isPanicMode ? "PANIC" : "STD")
    stopTypeColor = useStructStop ? color.orange : color.white
    table.cell(dashboard, 0, r + 4, "TP Mult/SL", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
    table.cell(dashboard, 1, r + 4, "TP: " + regimeMultText, text_color=regimeMultColor, text_size=size.small, bgcolor=rowBg)
    table.cell(dashboard, 2, r + 4, "SL: " + stopTypeText, text_color=stopTypeColor, text_size=size.small, bgcolor=rowBg)

    if inShort
        // Entry + P&L (row r+5)
        pnlColor = currentProfit > 0 ? color.green : color.red
        pnlBg = currentProfit > tp1_perc ? color.new(color.green, 85) : (currentProfit < -adaptedStopNormal * 0.5 ? color.new(color.red, 85) : rowBg)
        table.cell(dashboard, 0, r + 5, "Entry", text_color=color.gray, text_size=size.tiny, bgcolor=pnlBg)
        table.cell(dashboard, 1, r + 5, str.tostring(entryPrice, "#.##"), text_color=color.white, text_size=size.small, bgcolor=pnlBg)
        table.cell(dashboard, 2, r + 5, str.tostring(currentProfit * 100, "#.##") + "%", text_color=pnlColor, text_size=size.small, bgcolor=pnlBg)

        // SL + TP status (row r+6)
        tpStatus = tp2_hit ? "TP2 HIT" : (tp1_hit ? "TP1 HIT" : "RUNNING")
        tpStatusColor = tp2_hit ? color.green : (tp1_hit ? color.lime : color.white)
        slTypeText = not tp1_hit and useMCcap and not na(stopCap) and not na(trailStop) and math.abs(trailStop - stopCap) < 0.01 ? "CAP" : (useStructStop ? "STRUCT" : "STD")
        beActiveText = useBreakevenAfterTP1 and tp1_hit ? " BE" : ""
        trailStatusText = not useTrailingStop ? "NO TRAIL" : (trailActive ? "TRAIL " + str.tostring(effectiveTrailATR, "#.#") + "x" + beActiveText : "WAIT " + slTypeText)
        trailStatusColor = not useTrailingStop ? color.gray : (trailActive ? color.lime : color.orange)
        table.cell(dashboard, 0, r + 6, "SL / Trail", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 6, str.tostring(stopPrice, "#.##") + " " + trailStatusText, text_color=trailStatusColor, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 6, tpStatus, text_color=tpStatusColor, text_size=size.small, bgcolor=rowBg)

        // Exit score (row r+7)
        exitPct = exitThreshold > 0 ? math.min(exitScore / exitThreshold * 100, 100) : 0
        exitSbTag = isStrongBear ? " (SB)" : ""
        exitBarText = exitScore >= exitThreshold ? "EXIT!" : str.tostring(exitScore, "#.#") + "/" + str.tostring(exitThreshold, "#.#") + exitSbTag
        exitBg = exitScore >= exitThreshold ? color.new(color.orange, 70) : rowBg
        table.cell(dashboard, 0, r + 7, "Exit Score", text_color=color.gray, text_size=size.tiny, bgcolor=exitBg)
        table.cell(dashboard, 1, r + 7, exitBarText, text_color=exitScore >= exitThreshold ? color.orange : color.white, text_size=size.small, bgcolor=exitBg)
        table.cell(dashboard, 2, r + 7, str.tostring(exitPct, "#") + "%", text_color=exitScore >= exitThreshold * 0.7 ? color.orange : color.gray, text_size=size.small, bgcolor=exitBg)

        // TP levels (row r+8)
        table.cell(dashboard, 0, r + 8, "TP Levels", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 8, str.tostring(tp1Price, "#.#") + " / " + str.tostring(tp2Price, "#.#"), text_color=color.new(color.lime, 30), text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 8, tpStatus, text_color=tpStatusColor, text_size=size.tiny, bgcolor=rowBg)
    else
        // Signal readiness (row r+5)
        signalText = shortOK ? "READY!" : "WAITING"
        signalColor = shortOK ? color.lime : color.gray
        capPreviewText = useMCcap ? "Cap ~" + str.tostring(open_tf + atr14 * mcCapATRmult, "#.#") : ""
        table.cell(dashboard, 0, r + 5, "Signal", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 5, signalText, text_color=signalColor, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 5, capPreviewText, text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)

        // Entry checklist: red bars (row r+6)
        redBarsText = str.tostring(redBarsCount) + "/" + str.tostring(bearMinRedBars)
        redBarsColor = hasEnoughRedBars ? color.green : color.gray
        table.cell(dashboard, 0, r + 6, "Red Bars", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 6, redBarsText, text_color=redBarsColor, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 6, hasEnoughRedBars ? "OK" : "--", text_color=redBarsColor, text_size=size.small, bgcolor=rowBg)

        // Fear requirement (row r+7)
        fearReqLabel = isStrongBear ? "Fear(SB)" : "Fear Req"
        table.cell(dashboard, 0, r + 7, fearReqLabel, text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        table.cell(dashboard, 1, r + 7, str.tostring(fearIndex, "#.#") + " / " + str.tostring(activeBearMinFear, "#.#"), text_color=fearOK_bear ? color.green : color.gray, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 7, fearOK_bear ? "OK" : "--", text_color=fearOK_bear ? color.green : color.gray, text_size=size.small, bgcolor=rowBg)

        // Distance ATR (row r+8)
        table.cell(dashboard, 0, r + 8, "Dist ATR", text_color=color.gray, text_size=size.tiny, bgcolor=rowBg)
        distATROK = distATR >= 0 and distATR <= maxDistATR
        table.cell(dashboard, 1, r + 8, str.tostring(distATR, "#.#") + " / " + str.tostring(maxDistATR, "#.#"), text_color=distATROK ? color.green : color.gray, text_size=size.small, bgcolor=rowBg)
        table.cell(dashboard, 2, r + 8, distATROK ? "OK" : "--", text_color=distATROK ? color.green : color.gray, text_size=size.small, bgcolor=rowBg)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(shortPanic and not inShort, title="PANIC SHORT Signal", message="PANIC SHORT Signal detected! High fear conditions present.")
alertcondition(shortStandard and not inShort, title="Standard SHORT Signal", message="Standard SHORT signal detected in bear market.")
alertcondition(emergencyExit, title="Emergency Exit", message="EMERGENCY EXIT triggered - Strong bounce detected!")
alertcondition(isPanicMode and not isPanicMode[1], title="Panic Mode Activated", message="Market entering PANIC MODE - High volatility and fear detected!")
// Regime Shift alert
alertcondition(useRegimeShiftMonitor and regimeShiftScore >= 56 and regimeShiftScore[1] < 56, title="Regime Shift Warning", message="REGIME SHIFT SCORE alto su {{ticker}} — verificare cambio contesto SHORT")

// Footprint alerts (v3.2)
alertcondition(useFP and fpExtremeSell and not fpExtremeSell[1], title="FP Extreme Sell", message="FOOTPRINT: Extreme selling pressure su {{ticker}} — Delta molto negativo")
alertcondition(useFP and fpDeltaDivShort and not fpDeltaDivShort[1], title="FP Delta Div SHORT", message="FOOTPRINT: Delta divergence bearish su {{ticker}} — Prezzo sale, delta scende")
alertcondition(useFP and inShort and fpDeltaDivExit and fpExitWarningCount >= 2, title="FP Exit Warning", message="FOOTPRINT: Exit warning — Delta divergence con multipli segnali bullish")
alertcondition(useFP and fpAbsorption and not fpAbsorption[1], title="FP Absorption", message="FOOTPRINT: Absorption pattern su {{ticker}} — Buyer intrappolati, delta positivo con candela rossa")

// Breakeven alert (v3.4)
alertcondition(useBreakevenAfterTP1 and tp1_hit and not tp1_hit[1], title="Breakeven Activated", message="BREAKEVEN attivato su {{ticker}} — Stop spostato a entry price dopo TP1")
